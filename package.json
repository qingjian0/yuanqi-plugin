{
  "name": "dsh-yuanqi-plugin",
  "version": "1.1.0-alpha.9",
  "private": true,
  "type": "module",
  "description": "元炁（YuanQi）— DeepSeek Harness（DSH）生命上下文与持续演化插件",
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && find src -name '*.js' -type f -print0 | xargs -0 -n1 node --check && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "license": "GPL-3.0-only",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./domain": "./src/domain/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "defaultLocale": "zh-CN" },
  "dependencies": { "zod": "^4.4.3" },
  "files": ["LICENSE", "index.js", "src/**", "cordis.patch.yml", "README.md"],
  "x-default-language": "zh-CN"
}
